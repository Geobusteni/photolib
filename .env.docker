# Docker Compose Environment Variables
# Copy this to .env and configure for your deployment

# Database password (used by both PostgreSQL and app)
DB_PASSWORD=change-this-to-a-secure-password

# Session secret (64 hex characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-64-random-hex-characters

# Port to expose (default: 3000)
PORT=3000
