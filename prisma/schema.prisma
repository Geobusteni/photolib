generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  USER
  GUEST
}

enum AccessType {
  PASSWORD
  EMAIL
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String?  @unique
  password  String?
  name      String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments ProjectAssignment[]
}

model Project {
  id         String     @id @default(cuid())
  title      String
  eventDate  DateTime?
  accessType AccessType @default(PASSWORD)

  /// AES-256-GCM ciphertext, not a hash — the photographer must be able to read
  /// the password back to share it with a client.
  password String?

  /// The client-facing ZIP is uploaded by the admin, never generated from the
  /// photos. No archive means no "Download ZIP" button.
  archiveName String?
  archiveSize Int?

  expiresAt  DateTime?
  zipEnabled Boolean   @default(true)
  dlEnabled  Boolean   @default(true)
  dlCount    Int       @default(0)
  visitCount Int       @default(0)
  lastAccess DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  photos      Photo[]
  assignments ProjectAssignment[]
}

model ProjectAssignment {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
}

model Photo {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Generated UUID used on disk — keeps the filesystem free of traversal and
  /// encoding hazards.
  filename String

  /// The name the photographer uploaded. Used for downloads and ZIP entries.
  originalName String

  width     Int
  height    Int
  size      Int
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([projectId, originalName])
}
