# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# IDEs and editors
.idea
.vscode
*.suo
*.ntvs*
*.njsproj
*.sln

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env — single config file, never commit
.env
.env.backup
# .env.example and .env.docker are committed as documentation templates

# deployment tracking
.deployed-version

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
photolib.db
uploads/

/lib/generated/prisma
