# ─── Database ─────────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Percent-encode any @ / : # ? in the password.
DATABASE_URL='postgresql://<db-user>:<db-password>@localhost:5432/<db-name>'

# ─── Session ──────────────────────────────────────────────────────────────────
# 32+ random characters. Also encrypts gallery passwords: changing it makes
# existing ones unreadable. Single quotes prevent $ interpolation.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET='<64-hex-characters>'

# ─── Storage ──────────────────────────────────────────────────────────────────
# Absolute path recommended in production.
UPLOAD_DIR=./uploads
