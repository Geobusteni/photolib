# ─── Database ─────────────────────────────────────────────────────────────────
# MySQL connection string
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Percent-encode any @ / : # ? in the password.
# Example: mysql://photolib:your-password@localhost:3306/photolib
DATABASE_URL='mysql://<db-user>:<db-password>@localhost:3306/<db-name>'

# ─── Session ──────────────────────────────────────────────────────────────────
# 32+ random characters. Also encrypts gallery passwords: changing it makes
# existing ones unreadable. Single quotes prevent $ interpolation.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET='<64-hex-characters>'

# ─── Storage ──────────────────────────────────────────────────────────────────
# Absolute path recommended in production.
UPLOAD_DIR=./uploads
