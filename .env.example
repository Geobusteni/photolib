# ─── Database ─────────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Percent-encode any @ / : # ? in the password. See "Finding your DATABASE_URL" in README.md.
# Verify with: psql "<the string below>" -c "SELECT 1;"
DATABASE_URL='postgresql://photolib:PASSWORD@localhost:5432/photolib'

# ─── Session ──────────────────────────────────────────────────────────────────
# Must be 32+ random characters. Single quotes prevent $ interpolation.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET='your-32-char-secret-here'

# ─── Storage ──────────────────────────────────────────────────────────────────
# Absolute path recommended in production (e.g. /var/www/photolib/uploads)
UPLOAD_DIR=./uploads
